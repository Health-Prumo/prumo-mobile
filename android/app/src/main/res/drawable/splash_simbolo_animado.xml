<?xml version="1.0" encoding="utf-8"?>
<!-- Abertura do app: o fio de prumo balança e para alinhado (equilíbrio), enquanto os arcos se abrem.
     Termina exatamente no desenho parado de splash_simbolo.xml. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_simbolo">
    <target android:name="fio">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="7" android:duration="260" android:interpolator="@android:interpolator/decelerate_quad"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="7" android:valueTo="-5" android:duration="380" android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-5" android:valueTo="2.5" android:duration="320" android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="2.5" android:valueTo="-1" android:duration="260" android:interpolator="@android:interpolator/accelerate_decelerate"/>
                <objectAnimator android:propertyName="rotation" android:valueFrom="-1" android:valueTo="0" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="arcos">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="1.06" android:duration="420" android:interpolator="@android:interpolator/decelerate_quad"/>
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1.06" android:duration="420" android:interpolator="@android:interpolator/decelerate_quad"/>
                </set>
                <set>
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="1.06" android:valueTo="1" android:duration="600" android:interpolator="@android:interpolator/accelerate_decelerate"/>
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="1.06" android:valueTo="1" android:duration="600" android:interpolator="@android:interpolator/accelerate_decelerate"/>
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
